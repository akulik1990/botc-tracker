{
  "manifest_version": 3,
  "name": "BOTC vote tracker",
  "version": "0.1.0",
  "description": "Keeps every nomination and vote of a botc.app game, with highlight and compare.",
  "content_scripts": [
    {
      "matches": [
        "https://botc.app/*"
      ],
      "js": [
        "vote-tracker.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "botc-vote-tracker@akulik1990",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
