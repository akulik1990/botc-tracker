{
  "manifest_version": 3,
  "name": "BOTC tracker",
  "version": "0.5.0",
  "description": "Votes, claims, notes and worlds for botc.app, in panels you can dock or pop out.",
  "content_scripts": [
    {
      "matches": [
        "https://botc.app/*"
      ],
      "js": [
        "vendor/vue.global.prod.js",
        "src/rules.js",
        "src/style.js",
        "src/store.js",
        "src/panels.js",
        "src/main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "botc-vote-tracker@akulik1990",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
